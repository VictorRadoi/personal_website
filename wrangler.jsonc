{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "victor-radoi-portfolio",
  "compatibility_date": "2026-10-07",
  // Tiny Worker in front of the assets: 301s www → apex, otherwise serves the static site.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before asset matching so www requests get redirected instead of served.
    "run_worker_first": true,
    // Serve dist/404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Custom domains (Workers Custom Domains). Cloudflare manages their DNS records and certificates.
  "routes": [
    { "pattern": "rvandrei.com", "custom_domain": true },
    { "pattern": "www.rvandrei.com", "custom_domain": true }
  ]
}
