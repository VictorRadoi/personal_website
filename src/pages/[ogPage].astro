---
/**
 * Render target for scripts/og.mjs (site-spec §6): one 1200×630 card per page, picked with the URL
 * hash (#home, #dream-pivot, #teamboard, #goparty, #privacy) via :target. Type, paper texture and
 * app screenshots only; no photo of the owner. The route /og-template/ exists ONLY when OG_BUILD=1
 * (getStaticPaths returns nothing otherwise), so production builds and the sitemap never contain it and
 * never copy the large screenshot originals for it. noindex.
 * OWNER: Agent D.
 */
import type { GetStaticPaths } from 'astro';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import { getImage } from 'astro:assets';
import { getProjects, getSite } from '../lib/content';

export const getStaticPaths = (() =>
  import.meta.env.OG_BUILD === '1' || process.env.OG_BUILD === '1' ? [{ params: { ogPage: 'og-template' } }] : []) satisfies GetStaticPaths;

const site = await getSite();
const projects = await getProjects();

interface Card { id: string; kicker: string; headline: string; highlight?: string; byline: string; shots: { src: string; tilt: string; kind: string }[] }

async function shot(src: ImageMetadata, width: number) {
  const img = await getImage({ src, width, format: 'png' });
  return img.src;
}

const home = site.seo.ogImage;
const cards: Card[] = [];
{
  const by = Object.fromEntries(projects.map((p) => [p.id, p]));
  const pickShots = async (id: string, picks: [number, 'main' | number][]) => {
    const p = by[id].data;
    const list = [p.mainShot, ...p.features.flatMap((f) => f.shots)];
    const out = [];
    const tilts = ['a', 'b', 'c'];
    for (const [i, [idx]] of picks.entries()) {
      const s = list[idx];
      out.push({ src: await shot(s.src!, 360), tilt: tilts[i], kind: s.kind });
    }
    return out;
  };
  cards.push({
    id: 'home', kicker: 'rvandrei.com', headline: home.headline, highlight: home.highlight, byline: home.byline,
    shots: [
      ...(await pickShots('dream-pivot', [[0, 'main'], [3, 'main']])).slice(0, 1),
      ...(await pickShots('teamboard', [[0, 'main']])).map((s) => ({ ...s, tilt: 'b' })),
      ...(await pickShots('goparty', [[0, 'main']])).map((s) => ({ ...s, tilt: 'c' })),
    ],
  });
  for (const [id, line] of [
    ['dream-pivot', ['Client project · 2026', 'An AI career coach, built solo.', 'career coach']],
    ['teamboard', ['Co-founded · 2022 to now', 'The app sports clubs run on.', 'sports clubs']],
    ['goparty', ['Founding engineer · live since 2023', 'Find the night. Scan the door.', 'Scan the door']],
  ] as [string, string[]][]) {
    cards.push({
      id, kicker: line[0], headline: line[1], highlight: line[2], byline: `${by[id].data.title} case study · Victor-Andrei Rădoi · rvandrei.com`,
      shots: await pickShots(id, id === 'dream-pivot' ? [[0, 'main'], [3, 'main']] : id === 'goparty' ? [[0, 'main'], [1, 'main']] : [[0, 'main'], [1, 'main']]),
    });
  }
  cards.push({
    id: 'privacy', kicker: 'rvandrei.com', headline: 'Privacy, in plain words.', highlight: 'plain words',
    byline: 'Analytics only if you say yes · Victor-Andrei Rădoi', shots: [],
  });
}
const parts = (c: Card) => {
  if (!c.highlight || !c.headline.includes(c.highlight)) return [c.headline, '', ''];
  const [a, b] = c.headline.split(c.highlight);
  return [a, c.highlight, b];
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>OG template</title>
  </head>
  <body class="og-body">
    {
      cards.map((c) => {
        const [a, h, b] = parts(c);
        return (
          <article class="og-card" id={c.id}>
            <div class="og-copy">
              <p class="og-kicker">{c.kicker}</p>
              <p class="og-headline">{a}{h && <mark class="og-hl">{h}</mark>}{b}</p>
              <p class="og-byline">{c.byline}</p>
            </div>
            <div class="og-shots" aria-hidden="true">
              {c.shots.map((s) => (
                <div class={`og-shot og-shot--${s.tilt} og-shot--${s.kind}`}><img src={s.src} alt="" /></div>
              ))}
            </div>
          </article>
        );
      })
    }
  </body>
</html>

<style is:global>
  .og-body { margin: 0; inline-size: 1200px; block-size: 630px; overflow: hidden; background: var(--paper) var(--paper-tex); background-size: var(--tex-size); color: var(--ink); }
  .og-card { display: none; position: relative; inline-size: 1200px; block-size: 630px; overflow: hidden; }
  .og-card:target { display: block; }
  :root:not(:has(.og-card:target)) #home { display: block; }
  .og-copy { position: absolute; inset: 64px auto 56px 72px; inline-size: 620px; display: flex; flex-direction: column; justify-content: space-between; }
  .og-kicker { margin: 0; font-family: var(--font-text); font-weight: 700; font-size: 20px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .og-headline { margin: 0; font-family: var(--font-display); font-size: 76px; line-height: 1.06; letter-spacing: -.02em; }
  .og-hl { background: linear-gradient(transparent 58%, var(--highlighter-band) 58% 92%, transparent 92%); color: inherit; padding-inline: .08em; }
  .og-byline { margin: 0; font-family: var(--font-hand); font-size: 25px; line-height: 1.3; color: var(--ballpoint); white-space: nowrap; }
  .og-shots { position: absolute; inset-block: 0; inset-inline: 760px 0; }
  .og-shot { position: absolute; inline-size: 260px; padding: 6px; background: var(--card); border: 1.5px solid var(--ink); border-radius: 6px; box-shadow: 0 14px 30px rgb(var(--ink-rgb) / .22); }
  .og-shot img { display: block; inline-size: 100%; block-size: auto; }
  .og-shot--a { inset: 70px auto auto 20px; rotate: 3deg; }
  .og-shot--b { inset: 150px auto auto 250px; rotate: -4deg; }
  .og-shot--c { inset: 40px auto auto 250px; rotate: 5deg; }
  .og-card:not(#home) .og-shot--a { inset: 90px auto auto 10px; rotate: -3deg; }
  .og-card:not(#home) .og-shot--b { inset: 170px auto auto 230px; rotate: 4deg; }
  #home .og-shot--a { inset: 60px auto auto -10px; }
  #home .og-shot--b { inset: 230px auto auto 130px; }
  #home .og-shot--c { inset: 40px auto auto 270px; }
  #home .og-shot { inline-size: 200px; }
</style>
