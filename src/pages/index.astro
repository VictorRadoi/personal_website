---
/** Home: Hero → Ventures → Services → Work → Contact (fixed order, site-spec §3.4). OWNER (Phase 1): Agent C. */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Ventures from '../components/home/Ventures.astro';
import Services from '../components/home/Services.astro';
import Work from '../components/home/Work.astro';
import Contact from '../components/home/Contact.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---
<Base title={site.seo.home.title} description={site.seo.home.description} ogImage="/og/home.png" page="home">
  <Hero />
  <Ventures />
  <Services />
  <Work />
  <Contact slot="backcover" />
</Base>
