---
/**
 * OWNER: Agent A. The CTA strip (site-spec §3.2): .surface-card, 1.5px ink border,
 * no shadow; H3, body, CtaGroup, Kalam book note, the "Start a project" link (→ /start/, the brief
 * builder), CopyField (email), reply line.
 */
import Heading from '../layout/Heading.astro';
import CtaGroup from './CtaGroup.astro';
import CopyField from './CopyField.astro';
import TextLink from './TextLink.astro';
import Icon from '../layout/Icon.astro';
import { getBrief, getSite, type CtaLocation } from '../../lib/content';
import { trackAttrs } from '../../lib/track';
import { EMAIL } from '../../config';

interface Props {
  location: string;
}

const { location } = Astro.props;
const site = await getSite();
const brief = await getBrief();
const titleId = `cta-${location}-title`;
---
<div class="contact-cta" role="group" aria-labelledby={titleId}>
  <Heading level={3} size="m" id={titleId}>{site.cta.h3}</Heading>
  <p>{site.cta.body}</p>
  <CtaGroup location={location as CtaLocation} />
  <p class="hand-s">{site.cta.bookNote}</p>
  <p class="contact-cta__start">
    <TextLink href={`/start/?from=${location}`} track={trackAttrs('cta_click', { method: 'brief', location })}>
      {brief.ctaLink}<Icon name="arrow-right" size={16} />
    </TextLink>
  </p>
  <CopyField value={EMAIL} location={location} />
  <p class="meta">{site.cta.reply}</p>
</div>

<style>
  .contact-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: var(--card-pad);
    border: 1.5px solid var(--ink);
    border-radius: var(--r1);
    background: var(--card) var(--paper-tex) 200px 40px / var(--tex-size) repeat;
  }
  @media (min-width: 600px) { .contact-cta { padding: var(--s6); } }
  .contact-cta :global(.cta-group) { inline-size: 100%; }
  .contact-cta__start { font-size: var(--fs-small); margin-block-start: calc(-1 * var(--s1)); }
  .contact-cta__start { padding-block: 10px; line-height: 1.5; }
  .contact-cta__start :global(.icon) { margin-inline-start: 4px; }
</style>
