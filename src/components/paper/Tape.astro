---
/**
 * Masking tape strip(s) (design-system §10.2). Decorative; parent needs position: relative.
 * The .tape class is part of the reveal contract (base.css animates `.reveal-armed[data-reveal=place] .tape`).
 * `seed` picks the strip's small rotation deterministically (lib/tilt.ts). OWNER: Agent A.
 */
import { fnv1a } from '../../lib/tilt';

interface Props {
  placement: 'top' | 'corners' | 'side';
  seed: string;
}

const { placement, seed } = Astro.props;
const r = fnv1a(seed) % 5; // 0..4 → -3, -1.5, 0, 1.5, 3 degrees (top) / ±4 steps (side) / ±2 (corners)
---
{placement === 'corners' ? (
  <>
    <span class:list={['tape', 'tape--tl', `tape--r${r}`]} aria-hidden="true"></span>
    <span class:list={['tape', 'tape--tr', `tape--r${(r + 2) % 5}`]} aria-hidden="true"></span>
  </>
) : (
  <span class:list={['tape', `tape--${placement}`, `tape--r${r}`]} aria-hidden="true"></span>
)}

<style>
  .tape {
    --tape-rot: 0deg;
    position: absolute;
    z-index: var(--z-tape);
    inline-size: var(--tape-w);
    block-size: var(--tape-h);
    background: var(--tape);
    mix-blend-mode: multiply;
    pointer-events: none;
    clip-path: polygon(0 8%, 4% 0, 8% 10%, 12% 2%, 16% 9%, 20% 0, 80% 0, 84% 8%, 88% 1%, 92% 10%, 96% 2%, 100% 9%,
      100% 92%, 96% 100%, 92% 90%, 88% 99%, 84% 91%, 80% 100%, 20% 100%, 16% 92%, 12% 100%, 8% 91%, 4% 99%, 0 90%);
  }
  .tape--r0 { --tape-rot: -3deg; }
  .tape--r1 { --tape-rot: -1.5deg; }
  .tape--r2 { --tape-rot: 0deg; }
  .tape--r3 { --tape-rot: 1.5deg; }
  .tape--r4 { --tape-rot: 3deg; }

  /* overlap the object by ~10px */
  .tape--top { inset-block-start: calc(var(--tape-h) / -2); inset-inline-start: 50%; translate: -50% 0; rotate: var(--tape-rot); }
  .tape--tl { inset-block-start: -8px; inset-inline-start: -22px; rotate: calc(-38deg + var(--tape-rot) / 3); }
  .tape--tr { inset-block-start: -8px; inset-inline-end: -22px; rotate: calc(38deg + var(--tape-rot) / 3); }
  .tape--side { inset-block-start: 50%; inset-inline-start: calc(var(--tape-w) / -2 + 10px); translate: 0 -50%; rotate: calc(90deg + var(--tape-rot) * 1.3); }
</style>
