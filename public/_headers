# Cloudflare Workers Static Assets headers (rules cumulate; /* applies to all).
#
# CSP: Astro's stable security.csp (astro.config.mjs) hashes every inline script/style it emits
# and writes a <meta http-equiv="content-security-policy"> per page, so no 'unsafe-inline' is needed.
# Directives a <meta> tag cannot carry (frame-ancestors) are set here.
# A page may receive two policies (header + meta); the browser enforces the intersection.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'

# HTML needs no rule: Workers Static Assets already serves it with ETag + max-age=0 (revalidate).
# (Do not add Cache-Control to /*: rules cumulate and would be merged with the ones below.)

# Vite/Astro output is content-hashed: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

# Self-hosted fonts (+ their OFL license texts) and the paper texture never change in place:
# a changed file gets a new name (scripts/fonts.sh, src/styles/fonts.css, Base.astro preloads).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=31536000, immutable

# Old Flutter service worker kill switch: always revalidate so returning visitors pick it up.
/flutter_service_worker.js
  Cache-Control: no-cache
